#!/bin/sh
# pre-push: main nur mit Schalter, Release-Tags nur auf main, jeder Push privat gescannt.
# Push auf refs/heads/main nur mit RUNNING_APP_PUSH_MAIN=1 und nur als Fast-Forward (kein Löschen, kein
# Zurücksetzen). Den Schalter setzt nur, wer nach main mergt (der Merge-Schritt nach grünem Review und grüner CI auf
# dem PR, oder der Maintainer selbst); auf GitHub schützt zusätzlich die Regel für main. Arbeitsbranches (issue-*,
# wp/*) und alle anderen Pushes (auch Löschungen) bleiben frei.
# Ein Tag refs/tags/v* (auch annotiert) nur, wenn sein Commit schon in refs/remotes/origin/main liegt
# (Release-Pipeline, WP30); Tag-Löschungen sind frei.
# Vor allen Regeln scannt jeder Push (jede Ref außer Löschungen) die neuen Commits mit
# tool/check_private.sh --push (Autor und Committer, Nachrichten, Dateinamen, hinzugefügte Zeilen; Tag-Annotationen und der Ref-Name
# laufen über --stdin; Treffer lehnen ab; Umgehen nur --no-verify).
# Einrichtung: core.hooksPath=tool/hooks. Eingabe (stdin) wie bei Git:
#   <lokale ref> <lokaler sha> <remote ref> <remote sha>
zero=0000000000000000000000000000000000000000
rc=0
here=$(cd "$(dirname "$0")" && pwd)
while read -r lref lsha rref rsha; do
  if [ "$lsha" != "$zero" ]; then
    # Nur Refs des Push-Ziels ($1 = Remote-Name) gelten als schon veröffentlicht; Ziel-URL/unbekannt: alle Remotes.
    if git remote | grep -qxF -- "$1"; then pexcl="--remotes=$1/*"; else pexcl="--remotes"; fi
    [ "$rsha" != "$zero" ] && git cat-file -e "$rsha^{commit}" 2>/dev/null && pexcl="$pexcl $rsha"
    printf '%s\n' "$rref" | sh "$here/../check_private.sh" --stdin || { echo "pre-push: Privat-Scan abgelehnt (Ref-Name)." >&2; rc=1; }
    # shellcheck disable=SC2086
    sh "$here/../check_private.sh" --push "$lsha" --not $pexcl </dev/null || { echo "pre-push: Privat-Scan abgelehnt ($rref); Treffer bereinigen (Verlauf umschreiben, nicht nur löschen)." >&2; rc=1; }
    if [ "$(git cat-file -t "$lsha" 2>/dev/null)" = tag ]; then
      git cat-file tag "$lsha" | sh "$here/../check_private.sh" --stdin || { echo "pre-push: Privat-Scan abgelehnt (Tag-Annotation $rref)." >&2; rc=1; }
    fi
  fi
  case "$rref" in
    refs/tags/v*)
      [ "$lsha" = "$zero" ] && continue
      tcommit=$(git rev-parse -q --verify "$lsha^{commit}" 2>/dev/null) || tcommit=
      if [ -z "$tcommit" ] || ! git rev-parse -q --verify refs/remotes/origin/main >/dev/null \
         || ! git merge-base --is-ancestor "$tcommit" refs/remotes/origin/main 2>/dev/null; then
        echo "pre-push: Tag ${rref#refs/tags/} zeigt auf ${tcommit:-$lsha}, der nicht in origin/main liegt; Release-Tags nur auf Commits aus origin/main (erst main pushen, dann taggen)." >&2
        rc=1
      fi
      continue ;;
  esac
  [ "$rref" = refs/heads/main ] || continue
  if [ "${RUNNING_APP_PUSH_MAIN:-}" != 1 ]; then
    echo "pre-push: Push auf main nur mit RUNNING_APP_PUSH_MAIN=1 (Merge nach grünem Review und grüner CI). Arbeitsbranches: issue-<nr>-<slug> bzw. wp/<nr>-<slug>." >&2
    rc=1; continue
  fi
  if [ "$lsha" = "$zero" ]; then
    echo "pre-push: main darf nicht gelöscht werden." >&2; rc=1; continue
  fi
  if [ "$rsha" != "$zero" ] && ! git cat-file -e "$rsha^{commit}" 2>/dev/null; then
    echo "pre-push: Remote-Stand $rsha von main ist lokal unbekannt; erst fetch/merge." >&2; rc=1; continue
  fi
  # Kein Zurücksetzen/Force-Push: der Remote-Stand muss Vorfahr des neuen sein
  # (sonst wäre der Bereich rsha..lsha leer und die Prüfung wirkungslos).
  if [ "$rsha" != "$zero" ] && ! git merge-base --is-ancestor "$rsha" "$lsha" 2>/dev/null; then
    echo "pre-push: main wäre kein Fast-Forward von $rsha (Rücksetzen/Force-Push); abgelehnt." >&2
    rc=1; continue
  fi
done
exit $rc

#!/bin/sh
# pre-push: main nur über den Orchestrator-Befehl.
# Push auf refs/heads/main nur mit RUNNING_APP_PUSH_MAIN=1, und jeder neue Commit
# ist entweder von merge_wp.sh freigegeben (sein Tree steht in
# <git-common-dir>/running-app-merge-ok als „<tree> <commit>“; Zeilen, deren Commit schon
# in origin/main liegt, räumt der nächste Push weg; übersteht ein Amend der Nachricht; die
# Commits, die er mitbringt, gelten mit) oder ändert nur Dokumentation (docs/, work-packages/,
# PROJECT.md, AGENTS.md, README.md). Ein Tag refs/tags/v* (auch annotiert) nur, wenn sein Commit schon in
# refs/remotes/origin/main liegt (Release-Pipeline, WP30); Tag-Löschungen sind frei.
# Vor allen Regeln scannt jeder Push (jede Ref außer Löschungen) die neuen Commits mit
# tool/check_private.sh --push (Dateinamen, Nachrichten, hinzugefügte Zeilen; Treffer lehnen ab; Umgehen nur --no-verify).
# wp/*- und alle anderen Pushes (auch Löschungen) bleiben frei.
# Einrichtung: core.hooksPath=tool/hooks. Eingabe (stdin) wie bei Git:
#   <lokale ref> <lokaler sha> <remote ref> <remote sha>
zero=0000000000000000000000000000000000000000
ok_file="$(git rev-parse --path-format=absolute --git-common-dir)/running-app-merge-ok"
rc=0
here=$(cd "$(dirname "$0")" && pwd)
while read -r lref lsha rref rsha; do
  if [ "$lsha" != "$zero" ]; then
    pexcl="--remotes"
    [ "$rsha" != "$zero" ] && git cat-file -e "$rsha^{commit}" 2>/dev/null && pexcl="--remotes $rsha"
    # shellcheck disable=SC2086
    sh "$here/../check_private.sh" --push "$lsha" --not $pexcl </dev/null || { echo "pre-push: Privat-Scan abgelehnt ($rref); Treffer bereinigen (Verlauf umschreiben, nicht nur löschen)." >&2; rc=1; }
  fi
  case "$rref" in
    refs/tags/v*)
      [ "$lsha" = "$zero" ] && continue
      tcommit=$(git rev-parse -q --verify "$lsha^{commit}" 2>/dev/null) || tcommit=
      if [ -z "$tcommit" ] || ! git rev-parse -q --verify refs/remotes/origin/main >/dev/null \
         || ! git merge-base --is-ancestor "$tcommit" refs/remotes/origin/main 2>/dev/null; then
        echo "pre-push: Tag ${rref#refs/tags/} zeigt auf ${tcommit:-$lsha}, der nicht in origin/main liegt; Release-Tags nur auf Commits aus origin/main (erst main pushen, dann taggen)." >&2
        rc=1
      fi
      continue ;;
  esac
  [ "$rref" = refs/heads/main ] || continue
  if [ "${RUNNING_APP_PUSH_MAIN:-}" != 1 ]; then
    echo "pre-push: Push auf main nur mit RUNNING_APP_PUSH_MAIN=1 (Orchestrator: nach tool/merge_wp.sh bzw. für reine Doku-Commits). Arbeitsbranches: wp/<nr>-<slug>." >&2
    rc=1; continue
  fi
  if [ "$lsha" = "$zero" ]; then
    echo "pre-push: main darf nicht gelöscht werden." >&2; rc=1; continue
  fi
  if [ "$rsha" != "$zero" ] && ! git cat-file -e "$rsha^{commit}" 2>/dev/null; then
    echo "pre-push: Remote-Stand $rsha von main ist lokal unbekannt; erst fetch/merge." >&2; rc=1; continue
  fi
  # Kein Zurücksetzen/Force-Push: der Remote-Stand muss Vorfahr des neuen sein
  # (sonst wäre der Bereich rsha..lsha leer und die Prüfung wirkungslos).
  if [ "$rsha" != "$zero" ] && ! git merge-base --is-ancestor "$rsha" "$lsha" 2>/dev/null; then
    echo "pre-push: main wäre kein Fast-Forward von $rsha (Rücksetzen/Force-Push); abgelehnt." >&2
    rc=1; continue
  fi
  if [ "$rsha" = "$zero" ]; then excl=--remotes; else excl=$rsha; fi
  range="$lsha --not $excl"
  # Verbrauchte Freigaben (Commit schon in origin/main) entfernen; ein Push wird dadurch nie blockiert.
  if [ -f "$ok_file" ] && git rev-parse -q --verify refs/remotes/origin/main >/dev/null; then
    pruned=$(mktemp)
    recent=$(git log -n 300 --format=%T refs/remotes/origin/main)
    while read -r nt nc _; do
      [ -n "$nt" ] || continue
      if [ -n "$nc" ] && git merge-base --is-ancestor "$nc" refs/remotes/origin/main 2>/dev/null; then continue; fi
      if printf '%s\n' "$recent" | grep -qx "$nt"; then continue; fi
      echo "$nt${nc:+ $nc}"
    done < "$ok_file" > "$pruned"
    cat "$pruned" > "$ok_file"; rm -f "$pruned"
  fi
  # Durch einen notierten Tree abgedeckte Commits (der Commit und was er mitbringt).
  covered=$(mktemp)
  # shellcheck disable=SC2086
  for c in $(git rev-list $range); do
    t=$(git rev-parse "$c^{tree}")
    if [ -f "$ok_file" ] && awk -v t="$t" '$1==t{f=1} END{exit !f}' "$ok_file"; then
      # shellcheck disable=SC2086
      git rev-list "$c" --not $excl >> "$covered"
    fi
  done
  # shellcheck disable=SC2086
  for c in $(git rev-list $range); do
    grep -qx "$c" "$covered" && continue
    parents=$(git rev-parse "$c^@")
    if [ -n "$parents" ]; then
      # Gegen jeden Elternteil prüfen (ein Merge darf main nicht über den zweiten Elternteil zurücksetzen).
      files=""
      for pa in $parents; do
        files="$files
$(git diff --no-renames --name-only -z "$pa" "$c" | tr '\0' '\n')"
      done
    else
      files=$(git diff-tree --no-renames --root -r --name-only --no-commit-id "$c")
    fi
    bad=$(printf '%s\n' "$files" | grep -v '^$' | grep -vE "^(docs|work-packages)/|^(PROJECT|AGENTS|README)\.md$")
    if [ -n "$bad" ]; then
      echo "pre-push: $(git rev-parse --short "$c") ändert Code ($(echo "$bad" | head -3 | tr '\n' ' ')…) und ist nicht von tool/merge_wp.sh freigegeben (Tree nicht in $ok_file). main nur über merge_wp.sh." >&2
      rc=1; break
    fi
  done
  rm -f "$covered"
done
exit $rc

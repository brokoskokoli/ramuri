-- Schema Phase 1 (Version 1; Version 2 ergänzt Rohwerte des Standortgebers, Version 3 value_sections, Version 5 Referenzen von Rückmeldung und manuellem Training, Version 6 Referenzleistungen und abgelehnte Vorschläge). Zeiten: Mikrosekunden seit Epoch (UTC), Spalten
-- `*_us`. Einheiten SI: Meter `_m`, Sekunden `_s`, Grad `_deg`, Schläge je
-- Minute `_bpm`, Kilogramm `_kg`. Alles unter `runs` hängt per ON DELETE CASCADE
-- am Lauf (SEC-0004). Fremdschlüssel gelten nur bei `PRAGMA foreign_keys=ON`
-- (connection_setup.dart).

-- Meta-Tabelle aus Teil A.
CREATE TABLE storage_meta (
  "key" TEXT NOT NULL PRIMARY KEY,
  value TEXT NOT NULL
);

-- ---------------------------------------------------------------- Lauf
-- Lauf mit Zustand (ADR-0005 Punkt 5: aktiv; FR-0028: Pause, Ende).
CREATE TABLE runs (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  state TEXT NOT NULL CHECK (state IN ('active', 'paused', 'finished')),
  started_at_us INTEGER NOT NULL,
  -- NULL, solange der Lauf nicht beendet ist.
  ended_at_us INTEGER,
  -- Seit Version 3 (WP09 D2a): UTC-Versatz der Ortszeit zum Laufende in
  -- Sekunden (Zeitzone zum Laufzeitpunkt; Tageswerte hängen am lokalen
  -- Kalendertag des Laufendes). NULL = unbekannt: Läufe aus Version 1, oder
  -- der Aufrufer hat ihn nicht genannt; nur bei beendetem Lauf (Trigger).
  ended_utc_offset_s INTEGER CHECK (ended_utc_offset_s BETWEEN -64800 AND 64800)
);

CREATE TRIGGER runs_offset_insert BEFORE INSERT ON runs
WHEN NEW.ended_utc_offset_s IS NOT NULL AND NEW.ended_at_us IS NULL
BEGIN SELECT RAISE(ABORT, 'offset without end'); END;

CREATE TRIGGER runs_offset_update BEFORE UPDATE ON runs
WHEN NEW.ended_utc_offset_s IS NOT NULL AND NEW.ended_at_us IS NULL
BEGIN SELECT RAISE(ABORT, 'offset without end'); END;

-- Runden (FR-0030). Rundenzeit wie von der Aufzeichnung ermittelt (Sekunden).
CREATE TABLE laps (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  run_id INTEGER NOT NULL REFERENCES runs (id) ON DELETE CASCADE,
  lap_index INTEGER NOT NULL,
  marked_at_us INTEGER NOT NULL,
  lap_time_s REAL NOT NULL,
  UNIQUE (run_id, lap_index)
);

-- Lücken und Pausen, die die Aufzeichnung selbst markiert (FR-0194, FR-0193,
-- FR-0028). end_us ist NULL, solange die Lücke offen ist.
CREATE TABLE run_gaps (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  run_id INTEGER NOT NULL REFERENCES runs (id) ON DELETE CASCADE,
  kind TEXT NOT NULL CHECK (kind IN
    ('manual_pause', 'position_loss', 'heart_rate_loss', 'interruption')),
  start_us INTEGER NOT NULL,
  end_us INTEGER
);
CREATE INDEX run_gaps_run_time ON run_gaps (run_id, start_us);
CREATE INDEX laps_run_time ON laps (run_id, marked_at_us);

-- ------------------------------------------------- Rohdaten (nur anhängen)
-- Je Wert Zeitstempel, Quellgerät (FR-0020) und Zustand (FR-0057). Die
-- Wertspalten sind nur im Zustand `unavailable` leer (fehlende Angaben sind
-- NULL, nie 0; CHECK je Tabelle). `source` ist Text und kein Fremdschlüssel:
-- Rohdaten bleiben, auch wenn ein Gerät vergessen wird. Zustände wie
-- MeasurementState in core.
CREATE TABLE raw_positions (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  run_id INTEGER NOT NULL REFERENCES runs (id) ON DELETE CASCADE,
  time_us INTEGER NOT NULL,
  source TEXT NOT NULL,
  state TEXT NOT NULL
    CHECK (state IN ('present', 'estimated', 'unavailable', 'discarded')),
  latitude_deg REAL,
  longitude_deg REAL,
  accuracy_m REAL,
  -- Ab Version 2 (WP06 C, K12): Rohwerte des Standortgebers, NULL = nicht
  -- geliefert (nie 0). Zeilen aus Version 1 haben NULL.
  speed_mps REAL,
  speed_accuracy_mps REAL,
  vertical_accuracy_m REAL,
  CHECK (state = 'unavailable'
    OR (latitude_deg IS NOT NULL AND longitude_deg IS NOT NULL))
);

CREATE TABLE raw_heart_rates (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  run_id INTEGER NOT NULL REFERENCES runs (id) ON DELETE CASCADE,
  time_us INTEGER NOT NULL,
  source TEXT NOT NULL,
  state TEXT NOT NULL
    CHECK (state IN ('present', 'estimated', 'unavailable', 'discarded')),
  bpm INTEGER,
  contact TEXT NOT NULL CHECK (contact IN ('good', 'poor', 'unsupported')),
  CHECK (state = 'unavailable' OR bpm IS NOT NULL)
);

CREATE TABLE raw_altitudes (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  run_id INTEGER NOT NULL REFERENCES runs (id) ON DELETE CASCADE,
  time_us INTEGER NOT NULL,
  source TEXT NOT NULL,
  state TEXT NOT NULL
    CHECK (state IN ('present', 'estimated', 'unavailable', 'discarded')),
  altitude_m REAL,
  vertical_accuracy_m REAL,
  CHECK (state = 'unavailable' OR altitude_m IS NOT NULL)
);

CREATE TABLE raw_steps (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  run_id INTEGER NOT NULL REFERENCES runs (id) ON DELETE CASCADE,
  time_us INTEGER NOT NULL,
  source TEXT NOT NULL,
  state TEXT NOT NULL
    CHECK (state IN ('present', 'estimated', 'unavailable', 'discarded')),
  step_count INTEGER,
  CHECK (state = 'unavailable' OR step_count IS NOT NULL)
);

-- Ab Version 9 (WP26, FR-0213): RR-Intervalle, eine Zeile je BLE-Paket.
-- rr = uint16 little endian je Wert (Rohwert 1/1024 s, bitgenau, 0 und 65535
-- ungefiltert), also 2 Byte je Wert. time_us = Empfangszeitpunkt des Pakets,
-- source = Quellgerät (FR-0020).
CREATE TABLE raw_rr_packets (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  run_id INTEGER NOT NULL REFERENCES runs (id) ON DELETE CASCADE,
  time_us INTEGER NOT NULL,
  source TEXT NOT NULL,
  rr BLOB NOT NULL CHECK (length(rr) > 0 AND length(rr) % 2 = 0)
);

CREATE INDEX raw_positions_run_time ON raw_positions (run_id, time_us);
CREATE INDEX raw_heart_rates_run_time ON raw_heart_rates (run_id, time_us);
CREATE INDEX raw_altitudes_run_time ON raw_altitudes (run_id, time_us);
CREATE INDEX raw_steps_run_time ON raw_steps (run_id, time_us);
CREATE INDEX raw_rr_packets_run_time ON raw_rr_packets (run_id, time_us);

-- UPDATE auf Rohdaten: immer abbrechen (ADR-0004 Punkt 1).
CREATE TRIGGER raw_positions_no_update BEFORE UPDATE ON raw_positions
BEGIN SELECT RAISE(ABORT, 'raw data is append-only'); END;
CREATE TRIGGER raw_heart_rates_no_update BEFORE UPDATE ON raw_heart_rates
BEGIN SELECT RAISE(ABORT, 'raw data is append-only'); END;
CREATE TRIGGER raw_altitudes_no_update BEFORE UPDATE ON raw_altitudes
BEGIN SELECT RAISE(ABORT, 'raw data is append-only'); END;
CREATE TRIGGER raw_steps_no_update BEFORE UPDATE ON raw_steps
BEGIN SELECT RAISE(ABORT, 'raw data is append-only'); END;

CREATE TRIGGER raw_rr_packets_no_update BEFORE UPDATE ON raw_rr_packets
BEGIN SELECT RAISE(ABORT, 'raw data is append-only'); END;

-- DELETE auf Rohdaten nur über die Kaskade des Laufs: Dort ist die Lauf-Zeile
-- beim Löschen des Kindes schon weg (Test belegt das).
CREATE TRIGGER raw_positions_no_direct_delete BEFORE DELETE ON raw_positions
WHEN EXISTS (SELECT 1 FROM runs WHERE id = OLD.run_id)
BEGIN SELECT RAISE(ABORT, 'raw data is deleted only with its run'); END;
CREATE TRIGGER raw_heart_rates_no_direct_delete BEFORE DELETE ON raw_heart_rates
WHEN EXISTS (SELECT 1 FROM runs WHERE id = OLD.run_id)
BEGIN SELECT RAISE(ABORT, 'raw data is deleted only with its run'); END;
CREATE TRIGGER raw_altitudes_no_direct_delete BEFORE DELETE ON raw_altitudes
WHEN EXISTS (SELECT 1 FROM runs WHERE id = OLD.run_id)
BEGIN SELECT RAISE(ABORT, 'raw data is deleted only with its run'); END;
CREATE TRIGGER raw_steps_no_direct_delete BEFORE DELETE ON raw_steps
WHEN EXISTS (SELECT 1 FROM runs WHERE id = OLD.run_id)
BEGIN SELECT RAISE(ABORT, 'raw data is deleted only with its run'); END;

CREATE TRIGGER raw_rr_packets_no_direct_delete BEFORE DELETE ON raw_rr_packets
WHEN EXISTS (SELECT 1 FROM runs WHERE id = OLD.run_id)
BEGIN SELECT RAISE(ABORT, 'raw data is deleted only with its run'); END;

-- ------------------------------------------------------ Vorverarbeitung
-- Abgeleitet, jederzeit neu berechenbar (ADR-0004 Punkt 1); ersetzt bei
-- Neuberechnung die Zeilen des Laufs. Rohdaten bleiben unberührt.
CREATE TABLE preprocessing_results (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  run_id INTEGER NOT NULL UNIQUE REFERENCES runs (id) ON DELETE CASCADE,
  method TEXT NOT NULL,
  method_version INTEGER NOT NULL,
  parameter_version INTEGER NOT NULL,
  computed_at_us INTEGER NOT NULL,
  -- Gesamt- und Bewegungszeit getrennt (FR-0052); NULL = nicht verfügbar.
  total_time_s REAL,
  moving_time_s REAL,
  distance_m REAL,
  bridged_distance_m REAL,
  average_bpm REAL,
  max_bpm INTEGER,
  median_bpm REAL,
  -- Kurzfassung (run-overview, ab Schema 4): Bestpace, Rundenzahl und
  -- Bewegungszeit mit Puls; NULL = nicht verfügbar bzw. nicht bekannt.
  best_pace_s_per_km REAL,
  lap_count INTEGER,
  heart_rate_time_s REAL
);

-- Je Rohwert das Ergebnis des Filters: Zustand und Verwerfungsgrund.
-- raw_id verweist auf die Zeile des Kanals, bewusst ohne Fremdschlüssel.
CREATE TABLE preprocessed_samples (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  run_id INTEGER NOT NULL REFERENCES runs (id) ON DELETE CASCADE,
  channel TEXT NOT NULL
    CHECK (channel IN ('position', 'heart_rate', 'altitude', 'steps')),
  raw_id INTEGER NOT NULL,
  time_us INTEGER NOT NULL,
  state TEXT NOT NULL
    CHECK (state IN ('present', 'estimated', 'unavailable', 'discarded')),
  -- Namen wie DiscardReason in core; NULL, wenn nicht verworfen.
  discard_reason TEXT CHECK (discard_reason IN (
    'accuracy', 'hardJump', 'softJump', 'nonMonotonicTime',
    'implausibleHeartRate', 'noContact', 'heartRateOutlier',
    'verticalAccuracy', 'invalidValue'))
);
CREATE INDEX preprocessed_samples_run_time
  ON preprocessed_samples (run_id, channel, time_us);

-- Abgeleitete Zeitspannen: Bewegung, Einschwingzeit, Lücken je Kanal.
-- end_us NULL = offen.
CREATE TABLE preprocessed_spans (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  run_id INTEGER NOT NULL REFERENCES runs (id) ON DELETE CASCADE,
  kind TEXT NOT NULL CHECK (kind IN
    ('moving', 'settling', 'position_gap', 'heart_rate_gap')),
  start_us INTEGER NOT NULL,
  end_us INTEGER
);
CREATE INDEX preprocessed_spans_run_time
  ON preprocessed_spans (run_id, kind, start_us);

-- ---------------------------------------- Abschnitte mit Bewertung
-- Felder der SectionQuality aus core (FR-0048); Anteile 0..1, Dauern in s.
-- Zählungen je Zustand nach FR-0057.
CREATE TABLE rated_sections (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  run_id INTEGER NOT NULL REFERENCES runs (id) ON DELETE CASCADE,
  start_us INTEGER NOT NULL,
  end_us INTEGER NOT NULL,
  method TEXT NOT NULL,
  method_version INTEGER NOT NULL,
  parameter_version INTEGER NOT NULL,
  assessed_at_us INTEGER NOT NULL,
  heart_rate_present INTEGER NOT NULL,
  heart_rate_estimated INTEGER NOT NULL,
  heart_rate_unavailable INTEGER NOT NULL,
  heart_rate_discarded INTEGER NOT NULL,
  position_present INTEGER NOT NULL,
  position_estimated INTEGER NOT NULL,
  position_unavailable INTEGER NOT NULL,
  position_discarded INTEGER NOT NULL,
  missing_heart_rate_share REAL NOT NULL,
  longest_heart_rate_gap_s REAL NOT NULL,
  meets_heart_rate_gap_rule BOOLEAN NOT NULL CHECK (meets_heart_rate_gap_rule IN (0, 1)),
  settling_overlap_s REAL NOT NULL,
  settling_share REAL NOT NULL,
  -- JSON-Liste der GPS-Lücken [[start_us, end_us, offen 0/1], ...] (FR-0048).
  gps_gaps TEXT NOT NULL CHECK (json_valid(gps_gaps))
);
CREATE INDEX rated_sections_run_time ON rated_sections (run_id, start_us);

-- --------------------------------------------------- Berechnete Werte
-- Je Wert höchstens zwei Zeilen: unveränderlich `original` und `current`
-- (ADR-0004 Punkt 4, FR-0058). Entweder an einem Lauf (run_id) oder ein
-- Tageswert (day, ISO-Datum; z. B. ATL/CTL). Angaben nach FR-0053.
CREATE TABLE computed_values (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  run_id INTEGER REFERENCES runs (id) ON DELETE CASCADE,
  day TEXT,
  value_key TEXT NOT NULL,
  role TEXT NOT NULL CHECK (role IN ('original', 'current')),
  -- NULL genau dann, wenn unavailable_reason gesetzt ist (Qualitätsstufe
  -- 'undeterminable'; Trigger computed_values_reason_*).
  value_real REAL,
  unit TEXT NOT NULL,
  computed_at_us INTEGER NOT NULL,
  data_from_us INTEGER,
  data_to_us INTEGER,
  measurement_count INTEGER NOT NULL,
  -- JSON-Liste der Quellgeräte und -quellen.
  sources TEXT NOT NULL,
  method TEXT NOT NULL,
  method_version INTEGER NOT NULL,
  parameter_version INTEGER NOT NULL,
  quality TEXT NOT NULL CHECK (quality IN
    ('provisional', 'sufficient', 'good', 'undeterminable')),
  -- Seit Version 3 (WP09 D1): Grund, warum der Wert fehlt (FR-0068, PAR-037),
  -- als stabiler Code (Name von UnavailableReason im Core). Ein Code, den eine
  -- spätere App nicht kennt, ist beim Lesen ein Datenfehler.
  unavailable_reason TEXT,
  -- Seit Version 3 (WP09 D2a, OQ-0065): Schnappschuss der Herzfrequenzbasis,
  -- mit der der Wert gerechnet wurde, damit spätere Neuberechnungen alte Werte
  -- mit derselben Basis rechnen. hr_max_is_estimated ist der Anzeiger: NULL =
  -- kein Schnappschuss (Wert braucht keine Basis, oder Zeile aus Version 1:
  -- Basis unbekannt); sonst gilt der Schnappschuss, und hr_max_bpm bzw.
  -- hr_rest_bpm sind NULL, wenn die Basis diesen Wert nicht kannte. Bei
  -- hr_max_bpm / hr_rest_bpm ohne Anzeiger bricht der Trigger
  -- computed_values_basis_* ab.
  hr_max_bpm INTEGER CHECK (hr_max_bpm > 0),
  hr_rest_bpm INTEGER CHECK (hr_rest_bpm > 0),
  hr_max_is_estimated BOOLEAN CHECK (hr_max_is_estimated IN (0, 1)),
  CHECK ((run_id IS NULL) <> (day IS NULL))
);
CREATE UNIQUE INDEX computed_values_run_unique
  ON computed_values (run_id, value_key, role) WHERE run_id IS NOT NULL;
CREATE UNIQUE INDEX computed_values_day_unique
  ON computed_values (day, value_key, role) WHERE day IS NOT NULL;

-- Eine Zeile `original` ist unveränderlich; auch nicht zu `original` machen.
CREATE TRIGGER computed_values_original_immutable BEFORE UPDATE ON computed_values
WHEN OLD.role = 'original' OR NEW.role = 'original'
BEGIN SELECT RAISE(ABORT, 'original value is immutable'); END;

-- Kein fehlender Wert ohne Grund und kein Grund bei vorhandenem Wert (FR-0068).
-- Als Trigger statt CHECK, damit die Migration 2 -> 3 dasselbe Schema ergibt
-- wie das Anlegen (ADD COLUMN kann keine Regel über zwei Spalten ergänzen).
CREATE TRIGGER computed_values_reason_insert BEFORE INSERT ON computed_values
WHEN (NEW.value_real IS NULL) = (NEW.unavailable_reason IS NULL)
BEGIN SELECT RAISE(ABORT, 'value and unavailable_reason are exclusive'); END;

CREATE TRIGGER computed_values_reason_update BEFORE UPDATE ON computed_values
WHEN (NEW.value_real IS NULL) = (NEW.unavailable_reason IS NULL)
BEGIN SELECT RAISE(ABORT, 'value and unavailable_reason are exclusive'); END;

CREATE TRIGGER computed_values_basis_insert BEFORE INSERT ON computed_values
WHEN NEW.hr_max_is_estimated IS NULL
  AND (NEW.hr_max_bpm IS NOT NULL OR NEW.hr_rest_bpm IS NOT NULL)
BEGIN SELECT RAISE(ABORT, 'basis values without snapshot flag'); END;

CREATE TRIGGER computed_values_basis_update BEFORE UPDATE ON computed_values
WHEN NEW.hr_max_is_estimated IS NULL
  AND (NEW.hr_max_bpm IS NOT NULL OR NEW.hr_rest_bpm IS NOT NULL)
BEGIN SELECT RAISE(ABORT, 'basis values without snapshot flag'); END;

-- ------------------------------------------ Bewertete Abschnitte je Wert
-- Seit Version 3 (WP09 D1, FR-0073). Je Zeile von computed_values (original
-- und current getrennt) die bewerteten Abschnitte des Laufs: Zeitraum, GPS-
-- Median, Gewicht (PAR-033), Spätfaktor (PAR-024), Status, Gründe (JSON-Liste
-- der verletzten Regeln und Einschränkungen) und Schätzwert je Abschnitt.
-- Die Abschnitte eines `original` sind wie dieses unveränderlich.
CREATE TABLE value_sections (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  computed_value_id INTEGER NOT NULL REFERENCES computed_values (id) ON DELETE CASCADE,
  position INTEGER NOT NULL CHECK (position >= 0),
  start_us INTEGER NOT NULL,
  end_us INTEGER NOT NULL CHECK (end_us >= start_us),
  -- NULL, wenn keine Genauigkeit gemeldet wurde.
  gps_median_accuracy_m REAL CHECK (gps_median_accuracy_m >= 0),
  weight REAL NOT NULL CHECK (weight >= 0),
  late_factor REAL NOT NULL CHECK (late_factor >= 0),
  status TEXT NOT NULL CHECK (status IN ('eligible', 'provisional', 'rejected')),
  discard TEXT CHECK (discard IN ('implausible', 'incomplete', 'zeroWeight')),
  reasons TEXT NOT NULL CHECK (json_valid(reasons)),
  oxygen_demand REAL,
  estimate REAL,
  UNIQUE (computed_value_id, position)
) AS ValueSectionRow;

-- UPDATE: bei Abschnitten eines `original` immer abbrechen (auch Umhängen).
CREATE TRIGGER value_sections_original_immutable BEFORE UPDATE ON value_sections
WHEN (SELECT role FROM computed_values WHERE id = OLD.computed_value_id) = 'original'
  OR (SELECT role FROM computed_values WHERE id = NEW.computed_value_id) = 'original'
BEGIN SELECT RAISE(ABORT, 'original value sections are immutable'); END;

-- INSERT bei einem `original` nur direkt nach dessen Anlegen: Die Zeile des
-- Werts muss die zuletzt vergebene sein (der Adapter legt Original, dessen
-- Abschnitte, dann current an). Später kommt kein Abschnitt hinzu.
-- Annahme: MAX(id) ist die zuletzt angelegte Zeile von computed_values, weil
-- die ids per AUTOINCREMENT nur wachsen (nie neu vergeben werden) und original
-- und current eines Werts nur zusammen gelöscht werden. Es gibt keinen DELETE-
-- Trigger, wie bei computed_values selbst: Gelöscht wird nur über den Adapter
-- (deleteRun, deleteAll, Tausch über die ids der current-Zeilen).
CREATE TRIGGER value_sections_original_no_late_insert BEFORE INSERT ON value_sections
WHEN (SELECT role FROM computed_values WHERE id = NEW.computed_value_id) = 'original'
  AND NEW.computed_value_id <> (SELECT MAX(id) FROM computed_values)
BEGIN SELECT RAISE(ABORT, 'original value sections are immutable'); END;

-- -------------------------------------------- Profil und Einstellungen
-- Eine Zeile (id = 1). Alle Felder optional (FR-0002). Positive Zahlen für
-- Alter, Gewicht und Größe (OQ-0065); Plausibilität prüft WP05. Erfahrung
-- und Selbsteinschätzung sind bis Phase 2 zurückgestellt (OQ-0065).
CREATE TABLE profile (
  id INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
  birth_year INTEGER CHECK (birth_year > 0),
  body_weight_kg REAL CHECK (body_weight_kg > 0),
  body_height_m REAL CHECK (body_height_m > 0),
  resting_heart_rate_bpm INTEGER,
  max_heart_rate_bpm INTEGER,
  weekly_run_minutes INTEGER,
  -- Bitmaske Montag = Bit 0 bis Sonntag = Bit 6.
  training_days_mask INTEGER CHECK (training_days_mask BETWEEN 0 AND 127),
  usual_training_minutes INTEGER
);

-- Einstellungen als Schlüssel-Wert (Zonen, Einheiten, Autopause usw.; die
-- Schlüssel legen die jeweiligen Pakete fest).
CREATE TABLE settings (
  "key" TEXT NOT NULL PRIMARY KEY,
  value TEXT NOT NULL,
  updated_at_us INTEGER NOT NULL
);

-- ----------------------------------------------- Bekannte Geräte (FR-0013/14)
CREATE TABLE known_devices (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  device_id TEXT NOT NULL UNIQUE,
  display_name TEXT,
  is_preferred BOOLEAN NOT NULL DEFAULT 0 CHECK (is_preferred IN (0, 1)),
  added_at_us INTEGER NOT NULL
);
-- Höchstens ein bevorzugtes Gerät.
CREATE UNIQUE INDEX known_devices_one_preferred
  ON known_devices (is_preferred) WHERE is_preferred = 1;

-- ------------------------------------------------ Einwilligungen (SEC-0001/2/7)
-- Fehlt eine Zeile, gilt: nicht erteilt.
CREATE TABLE consents (
  source_key TEXT NOT NULL PRIMARY KEY,
  state TEXT NOT NULL CHECK (state IN ('granted', 'revoked')),
  changed_at_us INTEGER NOT NULL
);

-- ------------------------------------- Angaben zum Lauf (Version 5, WP18)
-- Höchstens eine Zeile je Lauf (1:1, FR-0038), alle Angaben einzeln optional.
-- Die Grenzen gelten auch gegen die Datenbank: RPE 0 bis 10, Befinden 1 bis 5,
-- nur ganze Zahlen (5.5 ist ein Fehler; INTEGER-Affinität würde sie sonst
-- behalten). Die Antwort auf die Warnsignal-Frage gibt es nur mit Beschwerden.
-- Der sRPE-Wert (FR-0095) steht als eigener Wert dabei, mit Bewegungszeit,
-- Methode und Version; er gehört nur zu einem vorhandenen RPE und wird nie mit
-- TRIMP zusammengerechnet (FR-0096). Gelöscht wird mit dem Lauf (Kaskade).
CREATE TABLE run_feedback (
  run_id INTEGER NOT NULL PRIMARY KEY REFERENCES runs (id) ON DELETE CASCADE,
  rpe INTEGER CHECK (rpe IS NULL OR (typeof(rpe) = 'integer' AND rpe BETWEEN 0 AND 10)),
  wellbeing INTEGER CHECK (wellbeing IS NULL OR (typeof(wellbeing) = 'integer' AND wellbeing BETWEEN 1 AND 5)),
  complaints TEXT,
  warning_answer TEXT CHECK (warning_answer IN ('yes', 'no')),
  note TEXT,
  srpe_points REAL CHECK (srpe_points >= 0),
  -- Bewegungszeit in Sekunden, mit der gerechnet wurde.
  srpe_duration_s REAL CHECK (srpe_duration_s >= 0),
  srpe_method TEXT,
  srpe_method_version INTEGER,
  CHECK (warning_answer IS NULL OR complaints IS NOT NULL),
  CHECK (
    (srpe_points IS NULL AND srpe_duration_s IS NULL AND srpe_method IS NULL AND srpe_method_version IS NULL)
    OR (srpe_points IS NOT NULL AND srpe_duration_s IS NOT NULL AND srpe_method IS NOT NULL AND srpe_method_version IS NOT NULL AND rpe IS NOT NULL)
  )
) AS RunFeedbackRow;

-- ------------------------------ Nachgetragene Trainings (Version 5, WP18)
-- Eigene Tabelle, nicht in `runs`: So bleiben VO2max, Bestwerte und alle
-- Lauf-Abfragen unberührt (FR-0199). Datum als Kalendertag `JJJJ-MM-TT`
-- (gültig, kein 30. Februar), Dauer in ganzen Sekunden größer 0, RPE Pflicht.
-- `other` ist Sonstiges (OQ-0058).
CREATE TABLE manual_trainings (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  day TEXT NOT NULL CHECK (day GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]' AND date(day) IS day),
  kind TEXT NOT NULL CHECK (kind IN ('run', 'other')),
  duration_s INTEGER NOT NULL CHECK (typeof(duration_s) = 'integer' AND duration_s > 0),
  rpe INTEGER NOT NULL CHECK (typeof(rpe) = 'integer' AND rpe BETWEEN 0 AND 10)
) AS ManualTrainingRow;
CREATE INDEX manual_trainings_day ON manual_trainings (day);

-- ------------------------------------- Leistungsprognose (Version 6, WP20)
-- Referenzleistungen (FR-0129): Art, Distanz, Zeit, Datum. `performed_on` ist
-- der lokale Kalendertag als ISO-Datum (YYYY-MM-DD). `created_at_us` entscheidet
-- bei gleichem Datum, welche die geltende ist. Ein bestätigter Lauf trägt die
-- Lauf-ID; mit dem Lauf verschwindet die Referenz (ON DELETE CASCADE). Distanz
-- und Zeit sind hier nur positiv; die Mindestdistanz (PAR-Wert) prüft `core`.
CREATE TABLE reference_performances (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  kind TEXT NOT NULL CHECK (kind IN ('race', 'test', 'confirmedRun')),
  distance_m REAL NOT NULL CHECK (distance_m > 0),
  time_s REAL NOT NULL CHECK (time_s > 0),
  performed_on TEXT NOT NULL CHECK (date(performed_on) IS performed_on),
  created_at_us INTEGER NOT NULL,
  run_id INTEGER REFERENCES runs (id) ON DELETE CASCADE,
  CHECK (kind <> 'confirmedRun' OR run_id IS NOT NULL)
) AS ReferenceRow;
CREATE INDEX reference_performances_run ON reference_performances (run_id);

-- Abgelehnte Vorschläge (FR-0131): Für diesen Lauf kommt kein Vorschlag mehr.
-- Hängt am Lauf (ON DELETE CASCADE).
CREATE TABLE rejected_suggestions (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  run_id INTEGER NOT NULL UNIQUE REFERENCES runs (id) ON DELETE CASCADE
);

-- Trainingsziel (WP21 Teil B, FR-0135 bis FR-0137, Schema 7): höchstens eine
-- Zeile (id = 1). Zahlen sind hier nur positiv, die Regeln (Lauftage
-- PAR-197, Datum) prüft `core`. Lauftage als Bitmaske, Bit 0 = Montag bis
-- Bit 6 = Sonntag; 1..127 heißt mindestens ein Tag. Ein Zeitziel trägt Strecke
-- und Zielzeit, ein Streckenziel nur die Strecke, ein offenes Ziel weder
-- Strecke, Zeit noch Datum (FR-0137, PAR-196). Heutiger Stand (PAR-192):
-- `current_weekly_s` und `can_run_30` dürfen beide leer/unbekannt sein, wenn
-- Läufe vorhanden sind; das prüft `core`, nicht das Schema. `hard_session` ist
-- der gespeicherte Schalter (PAR-198).
CREATE TABLE goals (
  id INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
  type TEXT NOT NULL CHECK (type IN ('distance', 'time', 'open')),
  distance TEXT CHECK (distance IN ('fiveKilometers', 'tenKilometers', 'halfMarathon')),
  target_s REAL CHECK (target_s > 0),
  target_date TEXT CHECK (date(target_date) IS target_date),
  run_days INTEGER NOT NULL CHECK (run_days BETWEEN 1 AND 127),
  max_session_s REAL NOT NULL CHECK (max_session_s > 0),
  weekly_cap_s REAL NOT NULL CHECK (weekly_cap_s > 0),
  current_weekly_s REAL CHECK (current_weekly_s > 0),
  can_run_30 TEXT NOT NULL CHECK (can_run_30 IN ('yes', 'no', 'unknown')),
  hard_session BOOLEAN NOT NULL CHECK (hard_session IN (0, 1)),
  created_at_us INTEGER NOT NULL,
  CHECK (
    (type = 'open' AND distance IS NULL AND target_s IS NULL AND target_date IS NULL) OR
    (type = 'distance' AND distance IS NOT NULL AND target_s IS NULL) OR
    (type = 'time' AND distance IS NOT NULL AND target_s IS NOT NULL)
  )
) AS GoalRow;

-- Fassungen des Trainingsplans (WP21 Teil C, ADR-0010 Punkt 1, 3, 5, 8,
-- Schema 7). Eine Zeile je echter Änderung; die Reihe ist der Verlauf.
-- `trigger` ist der Auslöser, `reason` der Grund-Code (der Satz entsteht in
-- der Oberfläche). `inputs` und `summary` sind JSON-Text. Hängt am Ziel
-- (ON DELETE CASCADE).
CREATE TABLE plans (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  goal_id INTEGER NOT NULL REFERENCES goals (id) ON DELETE CASCADE,
  created_at_us INTEGER NOT NULL,
  valid_from TEXT NOT NULL CHECK (date(valid_from) IS valid_from),
  "trigger" TEXT NOT NULL CHECK ("trigger" IN ('create', 'goalChange', 'weekly', 'feedback', 'run', 'pause', 'manual', 'ruleVersion')),
  reason TEXT NOT NULL CHECK (length(reason) > 0),
  method TEXT NOT NULL CHECK (length(method) > 0),
  method_version INTEGER NOT NULL CHECK (method_version >= 1),
  parameter_version INTEGER NOT NULL CHECK (parameter_version >= 1),
  inputs TEXT NOT NULL CHECK (json_valid(inputs)),
  summary TEXT NOT NULL CHECK (json_valid(summary))
) AS PlanRow;

CREATE INDEX plans_goal ON plans (goal_id);

-- Einheiten des Plans. `plan_id` ist die Fassung, die die Einheit erzeugt hat
-- (ON DELETE CASCADE). `week` zählt ab dem Anker der Fassung. `structure`
-- ist JSON-Text: Abschnitte mit Dauer und Zielintensität (RPE, Pace-Bereich,
-- Pulsbereich, Grundlage-Code, Kennzeichnung Schätzung; FR-0144, FR-0153).
-- Die Zielintensität steht nur dort, nicht in eigenen Spalten. `run_id` ordnet einen Lauf zu
-- (ON DELETE SET NULL: ein gelöschter Lauf löscht keine Plangeschichte, die
-- Einheit gilt dann als ausgefallen).
CREATE TABLE plan_units (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  plan_id INTEGER NOT NULL REFERENCES plans (id) ON DELETE CASCADE,
  day TEXT NOT NULL CHECK (date(day) IS day),
  week INTEGER NOT NULL CHECK (week >= 0),
  phase TEXT NOT NULL CHECK (phase IN ('entry', 'build', 'reduction')),
  kind TEXT NOT NULL CHECK (kind IN ('easy', 'long', 'intervals', 'tempo', 'progressive', 'walkRun', 'rest')),
  minutes INTEGER NOT NULL CHECK (minutes >= 0),
  structure TEXT NOT NULL CHECK (json_valid(structure)),
  run_id INTEGER REFERENCES runs (id) ON DELETE SET NULL,
  pinned BOOLEAN NOT NULL CHECK (pinned IN (0, 1)),
  -- Schema 8 (WP22): vom Nutzer Festgelegtes über den Termin hinaus. 'kind':
  -- Art ersetzt (bleibt bei jeder Neuberechnung), 'day': Ruhetag (nur mit
  -- kind = 'rest'), 'easyForHard': Art ersetzt, eine harte Einheit wurde
  -- locker (nur mit kind = 'easy'; die Woche hat dann keine harte Einheit).
  -- Alle nur mit bestätigtem Termin (pinned = 1). Zeilen aus Schema 7 und
  -- Archive mit Schema <= 7 bekommen 'none'.
  fixed TEXT NOT NULL DEFAULT 'none' CHECK (fixed IN ('none', 'day', 'kind', 'easyForHard') AND (fixed = 'none' OR (pinned = 1 AND (fixed = 'day') = (kind = 'rest') AND (fixed <> 'easyForHard' OR kind = 'easy'))))
) AS PlanUnitRow;

CREATE INDEX plan_units_day ON plan_units (day);
CREATE INDEX plan_units_plan ON plan_units (plan_id);
CREATE INDEX plan_units_run ON plan_units (run_id);

-- ------------------------------------------------ Warnsignal (Version 10, WP23)
-- Das aktive Warnsignal (FR-0203, K58): höchstens eine Zeile (`id = 1`).
-- `reported_on` ist der Ortstag der Meldung (ISO-Datum), `source` 'manual'
-- (Plan-Seite) oder 'run_feedback' (Antwort "ja" der Zusammenfassung). `run_id`
-- nennt den Lauf der Meldung, ist aber bewusst KEIN Fremdschlüssel: Die Zeile
-- überlebt das Löschen des Laufs (Warnsignal ist kein Teil der Lauf-Angaben).
-- Aufheben löscht die Zeile. Abschnitt 21 des Archivs.
CREATE TABLE active_warning (
  id INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
  reported_on TEXT NOT NULL CHECK (reported_on GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]' AND date(reported_on) IS reported_on),
  source TEXT NOT NULL CHECK (source IN ('manual', 'run_feedback')),
  run_id INTEGER CHECK (run_id IS NULL OR typeof(run_id) = 'integer')
) AS ActiveWarningRow;

<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- FR-0195, OQ-0064: Der Lauf verlangt genauen Standort (FINE). COARSE muss ab Android 12
         mit angefordert werden, damit der Nutzer "ungefähr" wählen kann; dann startet kein Lauf. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- ADR-0006 Punkt 3, FR-0008: Pulssensoren per Bluetooth LE. minSdk 31, daher
         nur die Rechte ab Android 12. neverForLocation: Die Suche leitet keinen Standort ab.
         Abgefragt wird erst beim Einrichten eines Sensors, nie beim Start. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <!-- ADR-0005 Punkt 2: Foreground Service der Aufzeichnung. Keine Hintergrund-Standortberechtigung,
         kein BOOT_COMPLETED für den Dienst. POST_NOTIFICATIONS fragt die App vor dem Laufstart; ohne sie
         (abgelehnt) läuft der Dienst, nur die Benachrichtigung ist nicht sichtbar. Der Wake Lock gilt nur für die Laufdauer. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE"/>
    <!-- ADR-0005 Nachtrag WP25: Typ health nur im Laufbandmodus (ohne Standort). Das Gate prüft, dass dieses Recht
         nur zusammen mit ACTIVITY_RECOGNITION und nur am Aufzeichnungsdienst vorkommt. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- FR-0202: Schrittsensor des Telefons für die Schrittfrequenz. Eigene Laufzeitberechtigung;
         ohne sie ist die Schrittfrequenz "nicht verfügbar" und der Lauf wird normal aufgezeichnet. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- ADR-0011 Punkt 5, FR-0214: Ruhepuls mit Rückkamera und Blitz (Kamera-PPG). Abgefragt wird erst
         beim Start der Messung. Kamera und Blitz sind nicht Pflicht (required=false): ohne sie bleibt
         die App installierbar und die manuelle Eingabe bleibt. Das Gate prüft beides am Release-APK. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- WP27: Vibration am Ende der Ruhephase der Ruhepuls-Messung (normales Recht, ohne Abfrage). -->
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.flash" android:required="false"/>
    <!-- FR-0174: Erinnerungen vor geplanten Einheiten. POST_NOTIFICATIONS fragt die App erst beim
         Einschalten. Wecker inexakt (kein SCHEDULE_EXACT_ALARM); nach Neustart plant
         TrainingReminderReceiver die gespeicherten Erinnerungen neu (nur Wecker, kein Dienst). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- SEC-0002, SEC-0008, ADR-0009: Netz nur für Kartenkacheln, nur mit Einwilligung, nur über den
         Kartenadapter (Gate-Schritt "Netz nur im Kartenadapter"), nur HTTPS (network_security_config). -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <application
        android:label="@string/app_name"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:name=".RunningApplication"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- connectedDevice nennt startForeground nur mit BLUETOOTH_CONNECT (RecordingLifecycle.startType),
             sonst wirft Android 14 eine SecurityException. health nur im Laufbandmodus (verlangt
             ACTIVITY_RECOGNITION, RecordingLifecycle.mayStart); GPS-Läufe starten weiter mit location. -->
        <service
            android:name=".RecordingService"
            android:exported="false"
            android:foregroundServiceType="location|connectedDevice|health"/>
        <!-- FR-0174: Wecker der Erinnerungen (explizites Intent) und Neuplanung nach Neustart oder
             Update. Nicht exportiert: Andere Apps können ihn nicht auslösen. -->
        <receiver
            android:name=".TrainingReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
            </intent-filter>
        </receiver>
        <!-- FR-0201: Teilen von Exportdateien. Nicht exportiert; Empfänger bekommen nur ein
             Leserecht auf die eine URI (FLAG_GRANT_READ_URI_PERMISSION, FileHandoffChannel.kt).
             Freigegeben ist nur cacheDir/exports/ (res/xml/file_paths.xml). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.exports"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"/>
        </provider>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <!-- WP24: Sprachausgabe des Systems (TextToSpeech) ab Android 11 sichtbar machen. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>

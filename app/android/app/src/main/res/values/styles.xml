<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Fenster beim Prozessstart: Nacht mit Zeichen (launch_background), auch im Hellmodus (OQ-0075). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Fenster zwischen Splash und erstem Flutter-Frame und hinter der Flutter-Oberfläche.
         Es trägt den Hintergrund der App (hell Papier, dunkel Nacht) statt Weiß oder Schwarz des
         Systemthemas: Das erste Bild schließt ohne Blitz an, und es gibt keine falschen Ränder. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/ramuri_paper</item>
    </style>
</resources>

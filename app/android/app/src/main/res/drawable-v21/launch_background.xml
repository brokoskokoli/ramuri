<?xml version="1.0" encoding="utf-8"?>
<!-- Fenster nach dem System-Splash bis zum ersten Flutter-Frame: Nacht mit Zeichen, ohne Text.
     240 dp wie die Symbolfläche der Splash-API, damit das Zeichen beim Wechsel nicht springt. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ramuri_night" />
    <item
        android:drawable="@drawable/ic_launcher_foreground"
        android:gravity="center"
        android:width="240dp"
        android:height="240dp" />
</layer-list>
